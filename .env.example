# Copy to .env and adjust. Never commit real secrets.

# Payload (open-source CMS at /admin)
PAYLOAD_SECRET=replace-with-a-long-random-string

# Public site source: keystatic (default) or payload
# CMS_SOURCE=payload

# Local (no Docker): SQLite file database
DATABASE_URI=file:./payload.db

# Production / Docker Postgres (see docker-compose.yml):
# DATABASE_URI=postgresql://payload:payload@127.0.0.1:5432/inspire_oman

# Optional: first admin for seed script
PAYLOAD_ADMIN_EMAIL=admin@inspireoman.local
PAYLOAD_ADMIN_PASSWORD=ChangeMe123!
