# Copy to .env and adjust. Never commit real secrets.

# Payload (open-source CMS at /admin)
PAYLOAD_SECRET=replace-with-a-long-random-string

# Public site source: keystatic (default) or payload
# CMS_SOURCE=payload

# Keystatic UI (defaults on in local dev; off in prod when CMS_SOURCE=payload)
# ENABLE_KEYSTATIC=true

# Local (no Docker): SQLite file database
DATABASE_URI=file:./payload.db

# Production / Docker Postgres (see docker-compose.yml):
# DATABASE_URI=postgresql://payload:payload@127.0.0.1:5432/inspire_oman

# Optional: first admin for seed script
PAYLOAD_ADMIN_EMAIL=admin@inspireoman.local
PAYLOAD_ADMIN_PASSWORD=ChangeMe123!

# Postmark (summit registration emails)
# POSTMARK_SERVER_TOKEN=
# POSTMARK_FROM_EMAIL=noreply@mefriend.com
# POSTMARK_FROM_NAME=Inspire Oman Team
# Optional default Reply-To. Registration emails override this with the registrant address.
# POSTMARK_REPLY_TO=
# POSTMARK_MESSAGE_STREAM=outbound
# Local only when antivirus/corporate TLS interception breaks Node fetch (SELF_SIGNED_CERT_IN_CHAIN).
# Never set in production Docker/Linux. Scopes insecure TLS to Postmark API calls only.
# POSTMARK_ALLOW_INSECURE_TLS=1

# Public HTTPS origin for <img> URLs in HTML emails (Gmail does not reliably show CID attachments).
# EMAIL_ASSET_BASE_URL=https://inspireoman.com
