# Copy to `.env` on the droplet (never commit real secrets).

# Strong random string (required)
PAYLOAD_SECRET=replace-with-long-random-secret

# Postgres (compose internal)
POSTGRES_USER=payload
POSTGRES_PASSWORD=replace-with-strong-db-password
POSTGRES_DB=inspire_oman

# Public URL of this droplet (no trailing slash)
# Use https://your-domain.com when DNS points here
NEXT_PUBLIC_SERVER_URL=http://YOUR_DROPLET_IP

# Public site content source: keystatic (YAML) or payload (/admin)
CMS_SOURCE=payload

# Caddy listen address
# IP-only HTTP:  :80
# Domain + auto HTTPS:  your-domain.com
SITE_ADDRESS=:80

# First admin user (create via seed or /admin create-first-user)
PAYLOAD_ADMIN_EMAIL=admin@inspireoman.local
PAYLOAD_ADMIN_PASSWORD=ChangeMe123!
